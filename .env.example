# Copy to .env and fill in. Never commit .env or production secrets.

# PostgreSQL connection string used at runtime.
# Supabase: use the "Transaction pooler" URI (port 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_ticketing?schema=public"

# Connection used only for migrations. A transaction pooler cannot run DDL or take
# advisory locks, so point this at a direct/session connection (Supabase: the
# "Session pooler" URI, port 5432). Set it to the same value as DATABASE_URL when
# your database is not behind a pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/college_ticketing?schema=public"

# Public base URL of the app
APP_URL="http://localhost:3000"

# Session cookie signing secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# QR payload signing key. Generate like SESSION_SECRET.
# Rotating it invalidates every QR already issued.
QR_SIGNING_SECRET=""
# How long a QR stays valid after the event ends (seconds, default 6h)
QR_TTL_SECONDS=21600

# Optional allow-list of sign-up email domains, comma-separated (e.g. "college.edu,gmail.com").
# Empty (the default) means any email address may register.
ALLOWED_EMAIL_DOMAINS=""

# Seed script demo password (dev only)
SEED_PASSWORD="Password123!"

# --- Email ---
# Leave EMAIL_PROVIDER_API_KEY empty to print confirmation emails to the server
# console instead of sending them. Set a Resend API key to deliver for real.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="College Events <onboarding@resend.dev>"

# PAYMENT_PROVIDER_KEY_ID=
# PAYMENT_PROVIDER_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# SENTRY_DSN=

# --- Google sign-in (optional) ---------------------------------------------
# Leave both blank to keep the feature off; the button will not render.
# Create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud
# console, and register this exact redirect URI:
#   ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
